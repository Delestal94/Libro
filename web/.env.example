# Copia este fichero como .env.local y rellena los valores.
# En Vercel, las mismas tres variables van en Settings -> Environment Variables.

# Repositorio donde vive el libro, en formato usuario/repo.
GITHUB_REPO=Delestal94/Libro

# Token de acceso con permiso de lectura y escritura sobre Contents de ese repo.
# GitHub -> Settings -> Developer settings -> Personal access tokens -> Fine-grained.
GITHUB_TOKEN=

# Rama sobre la que se guarda. Opcional, por defecto main.
GITHUB_BRANCH=main

# Contraseña única para entrar en la web.
SITE_PASSWORD=

# Opcional: secreto para firmar la cookie de sesión. Si se omite se usa
# SITE_PASSWORD, de modo que cambiar la contraseña cierra las sesiones abiertas.
AUTH_SECRET=
